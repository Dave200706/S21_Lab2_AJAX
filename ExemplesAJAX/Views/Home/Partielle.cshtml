@section Scripts {
    <script>
        function maFonctionClic() {
            var data = {
                qty: $('#inputQty').val(),
                texte: $('#inputTexte').val()
            };

            console.log(data);

            $.get('/Home/Partielle2', data, function(reponse) {
                $('#conteneur-partiel-2').html(reponse);
            });
        }

        $(document).ready(function() {
            $('#btnCharger').click(function() {
                maFonctionClic();
            });
        });
    </script>
}
<p>
    <b style="color: red;">Ma vue partielle!!</b>
</p>
